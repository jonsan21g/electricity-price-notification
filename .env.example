# Bidding zone in Denmark (DK2 for Greater Copenhagen/Zealand, DK1 for Jutland/Funen)
PRICE_AREA=DK2

# Price threshold in DKK per kWh (e.g., 1.0 for 1 Kr/kWh)
CHEAP_THRESHOLD_DKK=1.0

# Number of cheapest hours to highlight
TOP_CHEAPEST_COUNT=3

# All-inclusive price calculation (Grid tariffs + Energinet + State Tax + 25% Moms)
INCLUDE_TARIFFS=true
GRID_OPERATOR=Radius

# WhatsApp (CallMeBot) Configuration
# Phone number in international format without + or spaces (e.g. 4512345678)
CALLMEBOT_PHONE=45XXXXXXXX
# API key received from CallMeBot via WhatsApp
CALLMEBOT_API_KEY=your_api_key_here

# Enabled notifiers (comma-separated: whatsapp, email)
NOTIFIERS_ENABLED=whatsapp

# (Optional future Email setup)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your_email@gmail.com
# EMAIL_SMTP_PASSWORD=your_app_password
# EMAIL_TO=recipient@example.com
